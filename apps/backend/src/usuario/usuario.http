@baseUrl = http://localhost:3000/api/usuarios

### Listar todos los usuarios
GET {{baseUrl}}


# Ojo: el rol con ese id tiene que existir (el seed carga Adoptante=1, Voluntario=2,
# Administrador=3). El email es unico: los del seed ya estan tomados.
# Solo los voluntarios tienen refugio: un voluntario sin refugio, o cualquier otro rol con refugio, da 400
### 
# @name createUsuario
POST {{baseUrl}}
Content-Type: application/json

{
  "nombre": "Marcela",
  "apellido": "Rios",
  "email": "marcela.rios@example.com",
  "password": "123456",
  "telefono": "3415559001",
  "rol": 1
}



### ID
@id = {{createUsuario.response.body.data.id}}

### GET ONE
GET {{baseUrl}}/{{id}}


### PUT
PUT {{baseUrl}}/{{id}}
Content-Type: application/json

{
  "nombre": "Marcela Beatriz",
  "apellido": "Rios",
  "email": "marcela.rios@example.com",
  "telefono": "3415559002"
}


### PUT con refugio a un adoptante: da 400 (solo los voluntarios pueden pertenecer a un refugio)
PUT {{baseUrl}}/{{id}}
Content-Type: application/json

{
  "refugio": 1
}


### PUT a voluntario sin refugio: da 400 (un voluntario tiene que pertenecer a un refugio)
PUT {{baseUrl}}/{{id}}
Content-Type: application/json

{
  "rol": 2
}


### PUT a voluntario de Patitas al Rescate: el rol y el refugio van juntos
PUT {{baseUrl}}/{{id}}
Content-Type: application/json

{
  "rol": 2,
  "refugio": 1
}


### POST USUARIO TO DELETE
# @name createUsuarioToDelete
POST {{baseUrl}}
Content-Type: application/json

{
  "nombre": "Usuario",
  "apellido": "Eliminar",
  "email": "usuarioaborrar@example.com",
  "telefono": "3415559003",
  "password": "123456",
  "rol": 1
}

### ID TO DELETE
@idToDelete = {{createUsuarioToDelete.response.body.data.id}}
### DELETE
DELETE {{baseUrl}}/{{idToDelete}}