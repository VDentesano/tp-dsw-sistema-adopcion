@baseUrl = http://localhost:3000/api/refugios
### GET ALL
GET {{baseUrl}}

# El seed carga Patitas al Rescate (1) y Huellitas Funes (2), y las localidades 1 a 3.
# Este refugio queda con id 3
### POST
POST {{baseUrl}}
Content-Type:application/json

{
  "nombre": "Guarderia pepito",
  "direccion": "Alvear 50",
  "telefono": "2131445456",
  "email": "lala@gmail.com",
  "localidad": 1
}

### GET ONE
GET {{baseUrl}}/1

### PUT (el id 3 es el que creaste arriba)
PUT {{baseUrl}}/3
Content-Type: application/json

{
  "nombre": "Guarderia Porotos",
  "localidad": 2
}

### REMOVE
# Ojo: los refugios 1 y 2 tienen mascotas, usuarios y preguntas asociadas, borrarlos da 409
DELETE {{baseUrl}}/3