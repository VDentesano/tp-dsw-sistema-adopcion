@baseUrl = http://localhost:3000/api/roles

### Listar todos los roles
GET {{baseUrl}}

### Traer un rol por id (cambiá el id)
GET {{baseUrl}}/1

# Los roles Adoptante (1), Voluntario (2) y Administrador (3) ya los carga el seed,
# asi que el POST crea uno nuevo: queda con id 4
### Crear un rol
POST {{baseUrl}}
Content-Type: application/json

{
  "nombre": "Veterinario"
}

### Modificar un rol (el id 4 es el que creaste con el POST de arriba)
PUT {{baseUrl}}/4
Content-Type: application/json

{
  "nombre": "Veterinario de guardia"
}

### Eliminar un rol
# Ojo: los roles 1, 2 y 3 tienen usuarios asociados, borrarlos da 409
DELETE {{baseUrl}}/4
