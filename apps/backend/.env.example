# Plantilla de las variables de entorno del backend.
# Copiar este archivo como .env (que no se commitea) antes de levantar el proyecto:
#   cp apps/backend/.env.example apps/backend/.env
# Los valores de abajo son los que crea docker-compose.yml, asi que si usas Docker
# podes copiarlo tal cual y no tocar nada.

DB_HOST=localhost
DB_PORT=3306
DB_NAME=refugio
DB_USER=dsw
DB_PASSWORD=dsw
